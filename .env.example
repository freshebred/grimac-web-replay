# Public address: update this and Discord's redirect URI when deploying.
PUBLIC_URL=https://replay.example.com
SITE_HOST=replay.example.com

# Discord Developer Portal -> Application -> OAuth2.
# Redirect: https://replay.example.com/auth/discord/callback
# Only identify scope is used. A bot token and guild membership are not required.
DISCORD_CLIENT_ID=REPLACE_WITH_DISCORD_APPLICATION_ID
DISCORD_CLIENT_SECRET=REPLACE_WITH_DISCORD_CLIENT_SECRET
# Comma-separated numeric Discord user IDs (17-20 digits) allowed to sign in.
DISCORD_ALLOWED_IDS=100000000000000001,100000000000000002

# Generate locally with npm run secrets. Copy this same value to the mod's
# config/grim-replay/web-credential.json: {"web-token":"YOUR_VALUE"}
INGEST_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Container overrides HOST, DATA_DIR and WEB_DIR. These suit manual npm start.
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
WEB_DIR=../web/dist

# Every accepted incident expires after this many hours, including downloaded ones.
RETENTION_HOURS=24
SESSION_HOURS=12
# Capacity limits are safety bounds, not request-per-minute quotas.
MAX_STORAGE_BYTES=21474836480
MAX_UPLOAD_BYTES=33554432
MAX_EXPANDED_BYTES=134217728

# Optional. Leave blank unless you have verified an HTTPS raw-text GET endpoint
# for your paste provider. Exactly one {code} placeholder. Not the HTML paste page.
# Manual log attachment works without this. No guessed Grim download route.
GRIM_RAW_URL_TEMPLATE=
